# Firebase (register a Web app in Firebase Console for NEXT_PUBLIC_FIREBASE_APP_ID)
# Project settings → Your apps → Add app → Web → copy appId and measurementId (G-...)
# Do NOT use placeholder app IDs (e.g. ...web:0000000000000000000000) — Analytics will 404.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=momentra-e07c6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=momentra-e07c6
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=momentra-e07c6.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=827594123681
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google OAuth (web client from google-services.json client_type 3)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=827594123681-2m2bgmn1fuh1lmqeaoc8eijfuqn9j0qd.apps.googleusercontent.com

# Momentra API (production should be your public API host, not a local ngrok tunnel)
NEXT_PUBLIC_API_BASE_URL=https://api.mallaapp.org

# Vercel: set the same NEXT_PUBLIC_* vars in Project → Settings → Environment Variables.
# One deploy serves marketing (/) and the product app (/app). See VERCEL.md.

# Next.js 16 LAN dev HMR — comma-separated origins (from `ipconfig` IPv4)
# ALLOWED_DEV_ORIGINS=http://192.168.68.100:3000

