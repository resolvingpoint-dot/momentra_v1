{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momentra.local/schemas/guided_setup_catalog.schema.json",
  "title": "Guided Setup presentation catalog",
  "description": "Presentation metadata only. Must not define validation, required-field truth, or activation rules.",
  "oneOf": [
    { "$ref": "#/$defs/catalogBundle" },
    { "$ref": "#/$defs/templateCatalog" }
  ],
  "$defs": {
    "versionInt": {
      "type": "integer",
      "minimum": 1
    },
    "controlType": {
      "type": "string",
      "enum": [
        "chips",
        "cards",
        "multi_chips",
        "search_picker",
        "suggested_picker",
        "money",
        "percentage_chips",
        "text",
        "textarea",
        "toggle",
        "date",
        "member_picker",
        "switch_reveal"
      ]
    },
    "option": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": true,
      "properties": {
        "value": {
          "type": "string",
          "description": "Backend option code — must preserve exact engine codes"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "User-facing label — no raw snake_case"
        },
        "description": { "type": "string" },
        "icon": { "type": "string" }
      }
    },
    "explainer": {
      "type": "object",
      "required": ["title", "body"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "fieldMeta": {
      "type": "object",
      "required": ["field_key", "label", "control"],
      "additionalProperties": true,
      "properties": {
        "field_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Existing backend field key — unchanged"
        },
        "label": { "type": "string", "minLength": 1 },
        "helper": { "type": "string" },
        "placeholder": { "type": "string" },
        "control": { "$ref": "#/$defs/controlType" },
        "optional": { "type": "boolean" },
        "explainer": { "$ref": "#/$defs/explainer" },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        },
        "choices": {
          "type": "string",
          "description": "Key into shared choices map (bundle catalogs)"
        },
        "summary_label": { "type": "string" },
        "suggested": {
          "type": "array",
          "items": { "type": "string" }
        },
        "maxLength": { "type": "integer", "minimum": 1 },
        "icon": { "type": "string" }
      },
      "not": {
        "anyOf": [
          { "required": ["required"] },
          { "required": ["validation"] },
          { "required": ["activation_ready"] },
          { "required": ["min_selected"] },
          { "required": ["max_selected"] }
        ]
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": true,
      "properties": {
        "step": { "type": "integer", "minimum": 1, "maximum": 4 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "short_title": { "type": "string", "minLength": 1 },
        "shortTitle": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "intro": { "type": "string" },
        "optional": { "type": "boolean" },
        "hidden_when": { "type": ["string", "null"] },
        "hiddenWhen": { "type": ["string", "null"] },
        "fields": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/fieldMeta" },
              {
                "type": "object",
                "required": ["key", "label", "control"],
                "properties": {
                  "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                  "label": { "type": "string", "minLength": 1 },
                  "control": { "$ref": "#/$defs/controlType" }
                }
              }
            ]
          }
        },
        "sections": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "anyOf": [
        { "required": ["short_title"] },
        { "required": ["shortTitle"] }
      ]
    },
    "templateCatalog": {
      "type": "object",
      "required": [
        "catalog_version",
        "template_id",
        "template_version",
        "setup_version",
        "title",
        "steps"
      ],
      "additionalProperties": true,
      "properties": {
        "catalog_version": { "$ref": "#/$defs/versionInt" },
        "template_id": { "type": "string", "minLength": 1 },
        "template_version": { "$ref": "#/$defs/versionInt" },
        "setup_version": { "$ref": "#/$defs/versionInt" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "estimated_minutes": { "type": "integer", "minimum": 1 },
        "activate_cta": { "type": "string" },
        "activation_success": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/step" }
        },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/fieldMeta" }
        },
        "summary": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tips": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "not": {
        "anyOf": [
          { "required": ["validation"] },
          { "required": ["activation_rules"] },
          { "required": ["required_fields"] }
        ]
      }
    },
    "catalogBundle": {
      "type": "object",
      "required": ["catalog_version", "template_version", "setup_version", "templates"],
      "additionalProperties": true,
      "properties": {
        "catalog_version": { "$ref": "#/$defs/versionInt" },
        "template_version": { "$ref": "#/$defs/versionInt" },
        "setup_version": { "$ref": "#/$defs/versionInt" },
        "version": { "type": "string" },
        "estimated_minutes": { "type": "integer", "minimum": 1 },
        "shared": { "type": "object" },
        "choices": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/option" }
          }
        },
        "templates": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["title", "steps"],
            "properties": {
              "title": { "type": "string" },
              "subtitle": { "type": "string" },
              "activate_cta": { "type": "string" },
              "activation_success": { "type": "string" },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": { "$ref": "#/$defs/step" }
              },
              "fields": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/fieldMeta" }
              },
              "summary": { "type": "object" },
              "tips": { "type": "object" }
            }
          }
        }
      },
      "not": {
        "anyOf": [
          { "required": ["validation"] },
          { "required": ["activation_rules"] },
          { "required": ["required_fields"] }
        ]
      }
    }
  }
}
