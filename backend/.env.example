# ─── App ───────────────────────────────────────────────────────────────
APP_NAME=Momentra API
# DEBUG=true opens CORS to "*" and disables rate limiting (dev only).
DEBUG=false
# Dokploy production: set both. validate_production_security runs when
# MOMENTRA_ENV=production OR DEBUG=false.
# MOMENTRA_ENV=production

# Docker / Dokploy: run alembic on API container start (worker/beat should set false).
# RUN_MIGRATIONS_ON_START=true
# API_HOST=0.0.0.0
# API_PORT=8000
# UVICORN_WORKERS=2
# API_PUBLISH_PORT=8000

# Acceptance / local financial suite only. Requires DEBUG=true.
# ALLOW_TEST_AUTH=true
# ACCEPTANCE_DATABASE_URL=postgresql://momentra:momentra_test@localhost:15433/momentra_test

# ─── Database (PostgreSQL / Supabase) ──────────────────────────────────
# Plain postgresql:// is auto-upgraded to postgresql+asyncpg:// at runtime.
DATABASE_URL=postgresql://user:pass@host:5432/momentra
# Connection pool (SQLAlchemy async engine). Tune for your instance size /
# PgBouncer limits. pool_recycle avoids stale cloud-Postgres connections.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# ─── Firebase Admin (choose ONE option) ────────────────────────────────
# Option A: individual service-account fields via env vars
FIREBASE_PROJECT_ID=momentra-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@momentra-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: base64-encoded full service-account JSON (good for one-line env UIs)
# FIREBASE_SERVICE_ACCOUNT_JSON_B64=

# Option C: path to a service-account JSON file on disk
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase.json

# ─── App Session JWT ───────────────────────────────────────────────────
# REQUIRED when DEBUG=false — the app refuses to start with an empty secret
# (JWTs would otherwise be signed with an empty key). In production the secret
# must be at least 64 characters. Generate e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
APP_SESSION_SECRET=generate-a-random-at-least-64-char-secret-here-xxxxxxxxxxxx
APP_SESSION_EXPIRES_MINUTES=60
# Legacy fallback secret (used only if APP_SESSION_SECRET is unset).
# JWT_SECRET=
# SESSION_ALGORITHM=HS256

# ─── Invite links (QR / share / email) ─────────────────────────────────
# Base URL for invite_link / qr_payload. Token is appended as /{jwt}.
# Production: https://www.momentra.tech/invite → …/invite/{jwt}
# Use www (not apex): apex 308→www breaks Apple AASA / App Links verification.
# Local/dev custom scheme: momentra://invite
MOMENTRA_APP_INVITE_BASE_URL=https://www.momentra.tech/invite

# ─── Object storage (required in production) ───────────────────────────
# HTTPS public base for signed upload/download URLs. Local /local-uploads is
# only mounted when DEBUG=true. Production boots fail without https:// here.
# STORAGE_PUBLIC_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/momentra

# ─── CORS ──────────────────────────────────────────────────────────────
# Explicit allowlist only (no *). Include web app origins for credentialed cookies.
CORS_ORIGINS_STR=https://www.momentra.tech,https://momentra.tech,http://localhost:3000,http://127.0.0.1:3000

# ─── Redis (optional — falls back to in-memory cache & rate limiting) ──
# Local dev: redis://localhost:6379/0
# Docker Compose stack: redis://redis:6379/0
# REDIS_URL=redis://redis:6379/0

# ─── Celery background jobs (broker + result backend) ──────────────────
# When unset these fall back to REDIS_URL. Use a separate DB index to keep
# the broker isolated from the cache, e.g. redis://redis:6379/1
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_MAX_RETRIES=5
# CELERY_RETRY_BACKOFF_MAX=600
# CELERY_QUEUES=refresh,delivery,media,maintenance
# CELERY_CONCURRENCY=2
# CELERY_LOG_LEVEL=info

# ─── Rate limiting (applied only when DEBUG=false) ─────────────────────
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
